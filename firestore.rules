rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticato() {
      return request.auth != null;
    }

    function amministratore() {
      return autenticato()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.abilitato == true;
    }

    function destinatarioValido(destinatario) {
      return destinatario is map
        && destinatario.keys().hasAll([
          'nome', 'telefono', 'email', 'indirizzo', 'cap', 'citta', 'provincia', 'note'
        ])
        && destinatario.keys().hasOnly([
          'nome', 'telefono', 'email', 'indirizzo', 'cap', 'citta', 'provincia', 'note'
        ])
        && destinatario.nome is string
        && destinatario.nome.size() > 0
        && destinatario.nome.size() <= 140
        && destinatario.telefono is string
        && destinatario.telefono.size() > 0
        && destinatario.telefono.size() <= 40
        && destinatario.email is string
        && destinatario.email.size() <= 180
        && destinatario.indirizzo is string
        && destinatario.indirizzo.size() > 0
        && destinatario.indirizzo.size() <= 180
        && destinatario.cap is string
        && destinatario.cap.size() > 0
        && destinatario.cap.size() <= 20
        && destinatario.citta is string
        && destinatario.citta.size() > 0
        && destinatario.citta.size() <= 100
        && destinatario.provincia is string
        && destinatario.provincia.size() <= 80
        && destinatario.note is string
        && destinatario.note.size() <= 1000;
    }

    function ordineValido(ordine) {
      return ordine is map
        && ordine.keys().hasAll([
          'uid', 'numero', 'destinatario', 'items', 'totale', 'creatoIl', 'stato'
        ])
        && ordine.keys().hasOnly([
          'uid', 'numero', 'destinatario', 'items', 'totale', 'creatoIl',
          'stato', 'aggiornatoIl', 'annullatoIl'
        ])
        && ordine.uid is string
        && ordine.numero is string
        && ordine.numero.size() > 0
        && ordine.numero.size() <= 60
        && destinatarioValido(ordine.destinatario)
        && ordine.items is list
        && ordine.items.size() > 0
        && ordine.items.size() <= 100
        && ordine.totale is number
        && ordine.totale >= 0
        && ordine.creatoIl is timestamp
        && ordine.stato in ['ricevuto', 'annullato']
        && (!ordine.keys().hasAny(['aggiornatoIl']) || ordine.aggiornatoIl is timestamp)
        && (!ordine.keys().hasAny(['annullatoIl']) || ordine.annullatoIl is timestamp);
    }

    match /admins/{utenteId} {
      allow get: if autenticato() && request.auth.uid == utenteId;
      allow list, write: if false;
    }

    match /prodotti/{prodottoId} {
      allow read: if autenticato();
      allow create, update, delete: if amministratore();
    }

    match /carrelli/{utenteId} {
      allow read, write: if amministratore() && request.auth.uid == utenteId;
    }

    match /ordini/{ordineId} {
      allow create: if amministratore()
        && ordineValido(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.stato == 'ricevuto'
        && !request.resource.data.keys().hasAny(['aggiornatoIl', 'annullatoIl']);
      allow read: if amministratore();
      allow update: if amministratore()
        && ordineValido(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.creatoIl == resource.data.creatoIl
        && resource.data.get('stato', 'ricevuto') != 'annullato'
        && (
          request.resource.data.stato == resource.data.get('stato', 'ricevuto')
          || request.resource.data.stato == 'annullato'
        )
        && (
          request.resource.data.stato != 'annullato'
          || request.resource.data.keys().hasAny(['annullatoIl'])
        );
      allow delete: if false;
    }
  }
}
